@page "/fetchproducts"
@using ClientApp.Services
@using ClientApp.Models
@inject ProductService ProductService

<PageTitle>InventoryHub - Products</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-primary d-flex align-items-center gap-2">
                <i class="bi bi-box-seam-fill"></i> InventoryHub Products
            </h2>
            <p class="text-muted mb-0">Real-time product inventory catalog with optimized client/server caching</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (isCached)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Client Cached (2m TTL)
                </span>
            }
            else
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1">
                    <i class="bi bi-globe"></i> Live API Response
                </span>
            }
            <button class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" @onclick="RefreshProductsAsync" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Refreshing...</span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Refresh Data</span>
                }
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div>
                <strong>Error loading products:</strong> @errorMessage
            </div>
        </div>
    }
    else if (isLoading && products == null)
    {
        <!-- Loading State -->
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h5 class="text-muted">Loading Inventory Data...</h5>
        </div>
    }
    else if (products != null)
    {
        <!-- Metrics Bar -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 bg-primary bg-opacity-10 rounded-3 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Total Items</div>
                            <div class="fs-3 fw-bold text-primary">@FilteredProducts.Count()</div>
                        </div>
                        <div class="bg-primary text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-box fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-success bg-opacity-10 rounded-3 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Total Stock Volume</div>
                            <div class="fs-3 fw-bold text-success">@FilteredProducts.Sum(p => p.Stock)</div>
                        </div>
                        <div class="bg-success text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-layers-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-info bg-opacity-10 rounded-3 p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Categories</div>
                            <div class="fs-3 fw-bold text-info">@FilteredProducts.Select(p => p.Category?.Name).Distinct().Count()</div>
                        </div>
                        <div class="bg-info text-white p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-tags-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Controls -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0 ps-0" 
                                   placeholder="Search products by name or category..." 
                                   @bind="searchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="text-muted small">Showing @FilteredProducts.Count() of @products.Length products</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid / Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var product in FilteredProducts)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0 text-dark">@product.Name</h5>
                                    @if (product.Category != null)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-tag-fill me-1"></i>@product.Category.Name
                                        </span>
                                    }
                                </div>
                                <p class="text-muted small mb-3">Product ID: #@product.Id</p>
                            </div>

                            <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Price</span>
                                    <span class="fs-4 fw-bold text-success">$@product.Price.ToString("F2")</span>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small d-block">Stock Level</span>
                                    @if (product.Stock > 50)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                            @product.Stock in stock
                                        </span>
                                    }
                                    else if (product.Stock > 10)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill text-dark">
                                            @product.Stock left
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                            Low stock: @product.Stock
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Product[]? products;
    private string? errorMessage;
    private bool isCached;
    private bool isLoading = true;
    private string searchTerm = string.Empty;

    private IEnumerable<Product> FilteredProducts =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? (products ?? Array.Empty<Product>())
            : (products ?? Array.Empty<Product>()).Where(p =>
                p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (p.Category?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync(bool forceRefresh = false)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            isCached = !forceRefresh && ProductService.HasValidCache();
            products = await ProductService.GetProductsAsync(forceRefresh);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching product list: {ex.Message}");
            errorMessage = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshProductsAsync()
    {
        await LoadProductsAsync(forceRefresh: true);
    }
}
